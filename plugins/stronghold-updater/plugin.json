{
  "id": "stronghold-updater",
  "name": "卫戍协议 · 定时更新",
  "version": "2.3.0",
  "apiVersion": 1,
  "description": "按绑定服务定时更新官方增量包或 Git 代码；增量更新失败自动恢复文件，支持跨平台解压与下载进度。",
  "entry": "index.mjs",
  "actions": [
    {
      "key": "update",
      "label": "立即更新"
    },
    {
      "key": "check",
      "label": "检查最新版本"
    }
  ],
  "settings": [
    {
      "key": "mode",
      "type": "select",
      "label": "更新方式",
      "default": "release",
      "options": [
        {
          "value": "release",
          "label": "官方增量更新包"
        },
        {
          "value": "git",
          "label": "Git 拉取"
        }
      ]
    },
    {
      "key": "scheduleHour",
      "type": "number",
      "label": "每天几点更新（0-23）",
      "default": 4,
      "min": 0,
      "max": 23
    },
    {
      "key": "timeoutMinutes",
      "type": "number",
      "label": "下载 / 拉取超时（分钟）",
      "default": 30,
      "min": 1,
      "max": 180
    }
  ]
}
