[Unit]
Description=SHP independent server dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shp-dashboard
Group=shp-dashboard
WorkingDirectory=/opt/SHP-Server-Manager
EnvironmentFile=/opt/SHP-Server-Manager/.env
ExecStart=/usr/bin/node /opt/SHP-Server-Manager/src/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
# ProtectSystem=full 只读系统目录，允许写项目目录（保存 config.json、插件更新游戏目录）
ProtectSystem=full
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
