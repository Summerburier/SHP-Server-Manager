{
  "name": "stronghold-protocol-server-manager",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "独立的卫戍协议服务器监控与管理后台",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "node --watch --env-file-if-exists=.env src/server.js",
    "build": "vite build",
    "pretest": "npm run build",
    "test": "node --test",
    "test:browser": "node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "systeminformation": "^5.33.15",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "playwright-core": "^1.64.0",
    "vite": "^8.3.4"
  }
}
